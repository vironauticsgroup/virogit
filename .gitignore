# Dependencies (cli/node_modules, vscode-ext/node_modules, ...)
node_modules/

# Build output — cli compiles to dist/, VS Code extensions conventionally to out/ or dist/
dist/
out/
*.tsbuildinfo

# Packaged VS Code extension
*.vsix

# Generated copies of shared/ used by build steps (see cli/scripts/sync-shared.cjs and
# vscode-ext/scripts/copy-shared.js) — cli/dist/shared/ is already covered by dist/ above
cli/src/shared/
vscode-ext/lib/core/bundled/

# VS Code extension test runner cache
.vscode-test/

# Logs
*.log
npm-debug.log*

# Env / secrets
.env
.env.local

# OS
.DS_Store
Thumbs.db

# Editor swap files
*.swp
